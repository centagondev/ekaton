{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "ES2022",
    "useDefineForClassFields": true,
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "skipLibCheck": true,

    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,

    /* No "baseUrl": it is deprecated in TypeScript 6 and removed in 7. Since
       TS 4.1 "paths" resolves relative to the config file that declares it, so
       "./src/*" already means <project root>/src/*. Must stay in step with
       resolve.alias in vite.config.ts, which does the runtime half. */
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "include": ["src"]
}
